{
  "manifest_version": 2,
  "name": "Zotero Canvas",
  "version": "0.35.1",
  "description": "Local freeform canvases and mind maps linked to Zotero items and notes.",
  "author": "Zotero Canvas contributors",
  "icons": {
    "48": "content/icon.png",
    "96": "content/icon.png"
  },
  "applications": {
    "zotero": {
      "id": "research-canvas@local",
      "update_url": "https://raw.githubusercontent.com/Dcrizz/zotero-research-canvas/main/updates.json",
      "strict_min_version": "10.0",
      "strict_max_version": "10.0.*"
    }
  }
}
